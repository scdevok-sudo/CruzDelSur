# Plantilla de variables de entorno — copiar a .env.local (dev) y .env.production (build de Vercel).
# Ninguno de esos dos archivos se versiona (ver .gitignore).

VITE_SUPABASE_URL=https://[PROJECT_ID].supabase.co
VITE_SUPABASE_ANON_KEY=[ANON_KEY]

# development | production
VITE_APP_ENV=development

# WhatsApp del consultorio — formato 549 + código de área sin 0 + número sin 15
VITE_CONSULTORIO_WA_NUMBER=549221XXXXXXX
